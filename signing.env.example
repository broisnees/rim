# Release & signing settings for Rim. Copy to `signing.env` (kept out of version control) and fill in.
# Every script reads this file; environment variables override it.

APP_NAME="Rim"
BUNDLE_ID="com.getrim.Rim"
VERSION="1.0.0"          # CFBundleShortVersionString, shown to users
BUILD="1"                # CFBundleVersion, increase on every upload

# Local development: self-signed identity from ./make-cert.sh (keeps Accessibility granted across rebuilds).
DEV_IDENTITY="Rim Dev"

# Distribution (needs a paid Apple Developer Program membership):
#   Xcode → Settings → Accounts → Manage Certificates → + → "Developer ID Application"
#   then `security find-identity -p codesigning -v` shows the exact name to paste here.
DEVELOPER_ID=""          # e.g. "Developer ID Application: Your Name (ABCDE12345)"
TEAM_ID=""               # e.g. "ABCDE12345"

# Notarization credentials stored in the keychain by scripts/setup-signing.sh.
NOTARY_PROFILE="rim-notary"

# Release builds are universal (Apple Silicon + Intel) unless set to "native".
ARCHS="universal"
